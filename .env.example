# Copy to .env.local for local development (never commit .env.local).
# In production, set these in Vercel → Project → Settings → Environment Variables.

# Required. A dedicated key for this project only, from its own Claude Console workspace with a monthly spend limit.
ANTHROPIC_API_KEY=

# Optional. Defaults to claude-sonnet-5-5 when empty.
ANTHROPIC_MODEL=

# Optional. Extra site origins allowed to call /api/chat, comma-separated (e.g. a custom domain during migration).
# The site's own host is always allowed.
ALLOWED_ORIGINS=
